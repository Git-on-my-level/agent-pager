#!/usr/bin/env python3
"""Page a human from an agent or script. Standard library only, so it works when everything else is down.

  page [--sev info|wake] [--title T] [--url U] [--dedupe KEY] [--window SECONDS] [--source NAME] MESSAGE
  page test [--sev info|wake] [--loud]   send a test; a wake test stays quiet unless --loud
  page status                            show backends and recent sends; never prints secrets; exit 1 if none is set up

A message that is only the word status or test needs a separator: page -- status

Severity decides the route. By default wake tries bark, then ntfy, and rings through mute and Do Not Disturb on bark.
info goes to ntfy, then bark. Repeats of a key inside its window are suppressed (wake 15 minutes, info 1 hour). A failed
send is not recorded, so a retry goes out. Past 6 wakes an hour, further wakes go out as info: a looping agent can't
keep ringing the phone.

Exit 0 means a backend accepted it or it was suppressed as a repeat, 1 means every backend failed or none is set up,
2 means bad usage. Accepted doesn't mean seen: neither backend reports that the human read it.

Secrets are one file each, by default ~/.config/page/secrets/bark-key and ntfy-topic (mode 0600). A backend without a
file is skipped. ~/.config/page/config.json is optional; see the README. A bad setting is reported and ignored, and the
rest of the file still applies. A file that isn't valid JSON is ignored whole, so keep secrets at the default paths to
stay reachable through that too. State that can't be used, or a lock held past 15 seconds, is reported and
skipped, so that page goes out without suppression or the cap. $PAGE_CONFIG_DIR and $PAGE_STATE_DIR override the two
directories.
"""
import argparse
import contextlib
import fcntl
import hashlib
import importlib.util
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

__version__ = "0.3.0"
_support_spec = importlib.util.spec_from_file_location("page_support", Path(__file__).resolve().with_name("page_support.py"))
support = importlib.util.module_from_spec(_support_spec)
_support_spec.loader.exec_module(support)

MAX_CHARS = 240
TIMEOUT_SECONDS = 10
KEEP_SECONDS = 86400
LOCK_WAIT_SECONDS = 15
SECRET_FIELD = re.compile(
    r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"
    r"|(?i:(?:password|passwd|secret)\s*[=:]\s*\S+)"
    r"|(?i:\bbearer\s+\S+)"
    r"|(?i:(?:token|api[_-]?key)\s*=\s*\S+)"
    # After a colon, "token: expired" is a sentence. A value with a digit or some length is treated as a credential.
    r"|(?i:(?:token|api[_-]?key)\s*:\s*(?=\S*\d|\S{13})\S+)"
)
# A URL path keeps hashes and ids so the link still opens, so only these are masked there.
KNOWN_CREDENTIAL = re.compile(
    r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"
    r"|\bgh[opusr]_[A-Za-z0-9]{20,}"
    r"|\bgithub_pat_[A-Za-z0-9_]{20,}"
    r"|\bglpat-[A-Za-z0-9_\-]{10,}"
    r"|\bsk-[A-Za-z0-9_\-]{20,}"
    r"|\bxox[abprs]-[A-Za-z0-9\-]{10,}"
    r"|\bAIza[A-Za-z0-9_\-]{30,}"
)
LONG_RUN = re.compile(r"[A-Za-z0-9_\-+/=]{24,}")
READABLE_PART = re.compile(r"[A-Z]?[a-z]{1,18}|[A-Z]{1,19}|\d{1,8}|[A-Za-z0-9]{1,7}")
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
DEFAULTS = {
    "routes": {"wake": ["bark", "ntfy"], "info": ["ntfy", "bark"]},
    "windows": {"wake": 900, "info": 3600},
    "wake_cap_per_hour": 6,
    "backends": {
        "bark": {"server": "https://api.day.app", "secret_file": "secrets/bark-key", "volume": 5},
        "ntfy": {"server": "https://ntfy.sh", "secret_file": "secrets/ntfy-topic"},
    },
}
SEVERITIES = ("wake", "info")
RINGS_THROUGH_MUTE = {"bark"}
WAKE_PLACEHOLDERS = {"summary", "message", "body", "text", "test", "todo", "tbd", "placeholder"}
DEDUPE_PLACEHOLDERS = {"key", "dedupe", "name", "id", "todo"}
UNFILLED_TEMPLATE = re.compile(r"\{[^{}]*\}|<[^<>]*>|\$[A-Za-z_][A-Za-z0-9_]*|%s")


def wake_problem(text, dedupe):
    if text.strip().casefold() in WAKE_PLACEHOLDERS:
        return "message is a bare placeholder"
    if len(text.strip()) < 20:
        return "message must contain at least 20 characters after stripping whitespace"
    if (dedupe or "").strip().casefold() in DEDUPE_PLACEHOLDERS:
        return "--dedupe is a placeholder"
    if UNFILLED_TEMPLATE.search(text):
        return "message contains an unfilled template"
    return None


def caller_fields():
    """Best-effort local attribution; never request or record the parent's full argv."""
    ppid = os.getppid()
    parent_comm = ""
    try:
        result = subprocess.run(
            ["ps", "-o", "comm=", "-p", str(ppid)],
            capture_output=True, text=True, timeout=0.5, check=True,
        )
        parent_comm = Path(result.stdout.strip()).name
    except (OSError, subprocess.SubprocessError, UnicodeError):
        pass
    try:
        cwd = Path.cwd().name
    except OSError:
        cwd = ""
    return {"ppid": ppid, "parent_comm": parent_comm, "cwd": cwd}


def config_dir():
    return Path(os.environ.get("PAGE_CONFIG_DIR") or Path.home() / ".config/page")


def state_dir():
    return Path(os.environ.get("PAGE_STATE_DIR") or Path.home() / ".local/state/page")


def is_int(value, minimum):
    return isinstance(value, int) and not isinstance(value, bool) and value >= minimum


def is_safe_server(server):
    try:
        parts = urllib.parse.urlsplit(server)
    except ValueError:
        return False
    return (parts.scheme == "https" and bool(parts.hostname)) or (
        parts.scheme == "http" and parts.hostname in ("localhost", "127.0.0.1", "::1")
    )


def section(raw, name, problems):
    value = raw.get(name, {})
    if isinstance(value, dict):
        return value
    problems.append(f"{name} is not an object")
    return {}


def backend_setting_problem(name, key, value):
    if key not in DEFAULTS["backends"][name]:
        return f"backend {name} has unknown key {key}"
    if key in ("server", "secret_file") and not (isinstance(value, str) and value):
        return f"bad {name} {key}"
    if key == "server" and not is_safe_server(value):
        return f"{name} server must use https, or http on this machine: the secret is in the URL"
    if key == "volume" and not (is_int(value, 0) and value <= 10):
        return f"bad {name} volume"
    return None


def validate(raw):
    """Merges a parsed config over the defaults, returning (config, problems). A bad setting keeps its default and the
    rest still apply, because the setting that says where the secrets are may be fine."""
    config = json.loads(json.dumps(DEFAULTS))
    if not isinstance(raw, dict):
        return config, ["not a JSON object"]
    problems = []
    unknown = set(raw) - set(DEFAULTS)
    if unknown:
        problems.append(f"unknown keys {sorted(unknown)}")
    for sev, route in section(raw, "routes", problems).items():
        usable = isinstance(route, list) and route and all(isinstance(name, str) and name in BACKENDS for name in route)
        if sev in SEVERITIES and usable:
            config["routes"][sev] = route
        else:
            problems.append(f"bad route {sev}")
    for sev, window in section(raw, "windows", problems).items():
        if sev in SEVERITIES and is_int(window, 0):
            config["windows"][sev] = window
        else:
            problems.append(f"bad window {sev}")
    if "wake_cap_per_hour" in raw:
        if is_int(raw["wake_cap_per_hour"], 1):
            config["wake_cap_per_hour"] = raw["wake_cap_per_hour"]
        else:
            problems.append("bad wake_cap_per_hour")
    for name, settings in section(raw, "backends", problems).items():
        if name not in BACKENDS or not isinstance(settings, dict):
            problems.append(f"bad backend {name}")
            continue
        for key, value in settings.items():
            problem = backend_setting_problem(name, key, value)
            if problem:
                problems.append(problem)
            else:
                config["backends"][name][key] = value
    return config, problems


def load_config():
    """Returns (config, problem). A missing file is normal; a bad setting falls back to its default."""
    path = config_dir() / "config.json"
    try:
        config, problems = validate(json.loads(path.read_text()))
        return config, f"{path} partly ignored: {'; '.join(problems)}" if problems else None
    except FileNotFoundError:
        return json.loads(json.dumps(DEFAULTS)), None
    except Exception as error:  # Whatever is wrong with the file, the page still has to go out.
        return json.loads(json.dumps(DEFAULTS)), f"{path} ignored: {error}"


def secret(config, name):
    path = Path(config["backends"][name]["secret_file"]).expanduser()
    try:
        return (config_dir() / path).read_text().strip() or None
    except (OSError, ValueError):
        return None


def post(url, data, headers):
    request = urllib.request.Request(url, data=data, headers=headers, method="POST")
    with OPENER.open(request, timeout=TIMEOUT_SECONDS) as response:
        response.read()


def send_bark(config, message, loud):
    settings = config["backends"]["bark"]
    body = {"title": message["title"], "body": message["text"], "group": "page-" + message["sev"], "level": "active"}
    if loud:
        body.update(level="critical", volume=settings["volume"], call="1")
    if message["url"]:
        body["url"] = message["url"]
    url = f"{settings['server'].rstrip('/')}/{secret(config, 'bark')}"
    post(url, json.dumps(body).encode(), {"Content-Type": "application/json"})


def send_ntfy(config, message, loud):
    settings = config["backends"]["ntfy"]
    headers = {"Title": message["title"].encode("ascii", "replace").decode(), "Priority": "5" if loud else "3"}
    if message["url"]:
        headers["Click"] = message["url"]
    post(f"{settings['server'].rstrip('/')}/{secret(config, 'ntfy')}", message["text"].encode(), headers)


BACKENDS = {"bark": send_bark, "ntfy": send_ntfy}


def failure_reason(error):
    """Names the failure without the error's text, which can contain a URL holding the secret."""
    if isinstance(error, urllib.error.HTTPError):
        return f"http {error.code}"
    return type(error).__name__


def deliver(config, message, loud):
    """Tries each set-up backend on the route in order. Returns (backend or None, failure reasons)."""
    failures = []
    for name in config["routes"][message["sev"]]:
        if not secret(config, name):
            continue
        try:
            BACKENDS[name](config, message, loud)
            return name, failures
        except Exception as error:  # Any failure, such as a truncated response, moves on to the next backend.
            failures.append(f"{name}: {failure_reason(error)}")
    return None, failures


def is_entry(entry):
    return (
        isinstance(entry, dict)
        and isinstance(entry.get("at"), (int, float))
        and all(isinstance(entry.get(field), str) for field in ("key", "sev", "backend"))
    )


def keep_seconds(entry):
    """An entry stays as long as its window needs, so a window past a day still suppresses."""
    window = entry.get("window")
    return max(KEEP_SECONDS, window) if isinstance(window, int) else KEEP_SECONDS


def read_log():
    try:
        lines = (state_dir() / "sent.jsonl").read_text().splitlines()
    except (OSError, ValueError):
        return []
    now = time.time()
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if is_entry(entry) and now - entry["at"] < keep_seconds(entry):
            entries.append(entry)
    return entries


def write_log(entries):
    path = state_dir() / "sent.jsonl"
    temporary = path.with_suffix(".tmp")
    temporary.write_text("".join(json.dumps(entry) + "\n" for entry in entries))
    temporary.replace(path)


def short_hostname():
    return socket.gethostname().split(".")[0]


def mask_run(match):
    """Masks a long run unless it reads as words joined up, such as a branch name, a path or a query like card=some-name.
    This machine's own name always stays, so a page can say where it came from."""
    run = match.group()
    if run == short_hostname():
        return run
    readable = "+" not in run and all(READABLE_PART.fullmatch(part) for part in re.split(r"[-_/=]", run) if part)
    return run if readable else "[masked]"


def mask(text):
    return LONG_RUN.sub(mask_run, SECRET_FIELD.sub("[masked]", text))


def clean(text):
    """Keeps a message short and masks anything shaped like a token. The text goes through third-party servers."""
    return mask(" ".join(text.split()))[:MAX_CHARS]


def clean_url(url):
    """Drops any login and masks tokens in the query and fragment. The path loses only known credential shapes, so the
    link still opens."""
    try:
        parts = urllib.parse.urlsplit(url.strip())
    except ValueError:
        return None
    query, fragment = mask(parts.query), mask(parts.fragment)
    path = KNOWN_CREDENTIAL.sub("[masked]", SECRET_FIELD.sub("[masked]", parts.path))
    cleaned = urllib.parse.urlunsplit((parts.scheme, parts.netloc.rpartition("@")[2], path, query, fragment))
    return urllib.parse.quote(cleaned, safe="%/:=&?~#+!$,;'@()*[]")


def open_lock():
    """Returns the held lock, or None if it can't be had soon. An unrecorded page beats one lost to bad state or a hang."""
    try:
        state_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = open(state_dir() / "lock", "w")
    except OSError:
        return None
    deadline = time.monotonic() + LOCK_WAIT_SECONDS
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except OSError:
            if time.monotonic() >= deadline:
                lock.close()
                return None
            time.sleep(0.1)


def run_page(sev, text, title, url, dedupe, window, source, loud=None, incident=None):
    config, problem = load_config()
    if problem:
        print(f"page: {problem}", file=sys.stderr)
    host = short_hostname()
    attribution = dict(host=host, source=clean(source or "unattributed"), asked=sev,
                       incident=clean(incident["name"]) if incident else None, **caller_fields())
    def finish(code, outcome, **fields):
        if not support.audit(state_dir(), dict(attribution, outcome=outcome, **fields)):
            print("page: audit unavailable", file=sys.stderr)
        return code
    message = {
        "sev": sev,
        "text": clean(text),
        "title": clean(title or f"{sev}: {source or host}"),
        "url": clean_url(url) if url else None,
    }
    if not message["text"]:
        print("page: empty message", file=sys.stderr)
        return finish(2, "refused", reason="empty_message")
    key = hashlib.sha256((dedupe or f"{message['title']}|{message['text']}").encode()).hexdigest()[:16]
    window = config["windows"][sev] if window is None else window
    cap = config["wake_cap_per_hour"]
    loud = sev == "wake" if loud is None else loud
    capped = False

    lock = open_lock()
    if lock is None:
        print("page: state unavailable, sending without suppression or the wake cap", file=sys.stderr)
    with lock or contextlib.nullcontext():
        entries = read_log() if lock else []
        now = time.time()
        policy_reason = "legacy"
        updated = None
        if incident:
            policy_path = state_dir() / "incidents" / (support.incident_key(source or "unattributed", incident["name"]) + ".json")
            try:
                if not lock:
                    raise OSError("incident state unavailable")
                previous = json.loads(policy_path.read_text()) if policy_path.exists() else {}
                if not isinstance(previous, dict):
                    raise ValueError("invalid incident state")
                updated, effective, policy_reason, generation = support.incident_decision(
                    previous, condition=incident["condition"], observed_at=incident["observed_at"], now=now,
                    wake_after=incident["wake_after"], resolve_after=incident["resolve_after"],
                    max_age=incident["max_age"], handling=incident["handling"],
                    human_action=incident["human_action"], requested=sev)
                policy_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                temp = policy_path.with_suffix(".tmp")
                with os.fdopen(os.open(temp, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600), "w") as handle:
                    json.dump(updated, handle, allow_nan=False)
                temp.replace(policy_path)
            except (OSError, ValueError, KeyError, TypeError):
                effective, policy_reason, generation = "info", "incident_state_unavailable", 0
            attribution.update(condition=incident["condition"], handling=incident["handling"],
                               observed_at=incident["observed_at"], policy=policy_reason,
                               owner=clean(incident["owner"] or "unassigned"))
            if effective is None:
                print("page: deferred " + policy_reason)
                return finish(0, "deferred", reason=policy_reason)
            message["sev"] = effective
            loud = effective == "wake"
            # Dedupe is owned by incident+phase+severity, not caller counters.
            key = support.incident_key(source or "unattributed", incident["name"]) + "-" + str(generation) + "-" + incident["condition"] + "-" + effective
            window = max(window, 86400)
            if effective == "wake":
                message["text"] = clean(incident["human_action"] + ": " + text)
            message["title"] = clean(title or f"{effective}: {source or host}")
        if incident and loud and sum(bool(e.get("rang")) and now - e["at"] < 3600 for e in entries) >= cap:
            # Capped info is not a wake acknowledgement. Once the cap clears,
            # retry the same incident's wake rather than suppressing it all day.
            capped = True
            message["sev"] = "info"
            message["title"] = clean("wake cap: " + message["title"])
            loud = False
            window = min(window, 3600)
        dedupe_sev = message["sev"]
        if any(e["key"] == key and e.get("asked") == message["sev"] and now - e["at"] < window for e in entries):
            print(f"page: suppressed repeat of {key} (window {window}s)")
            return finish(0, "suppressed", reason=policy_reason, effective=message["sev"], key=key)
        if loud and sum(bool(e.get("rang")) and now - e["at"] < 3600 for e in entries) >= cap:
            print(f"page: over {cap} wakes an hour, sending as info", file=sys.stderr)
            capped = True
            message["sev"] = "info"
            message["title"] = clean("wake cap: " + message["title"])
            loud = False
        backend, failures = deliver(config, message, loud)
        for failure in failures:
            print(f"page: {failure}", file=sys.stderr)
        if backend is None:
            print("page: not sent, " + ("every backend failed" if failures else "no backend set up"), file=sys.stderr)
            return finish(1, "failed", effective=message["sev"], reason="; ".join(failures) or "no_backend", key=key)
        if incident and lock and isinstance(updated, dict):
            updated["notified"] = True
            try:
                temp = policy_path.with_suffix(".tmp")
                with os.fdopen(os.open(temp, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600), "w") as handle:
                    json.dump(updated, handle, allow_nan=False)
                temp.replace(policy_path)
            except (OSError, ValueError):
                print("page: sent but incident receipt not recorded", file=sys.stderr)
        if lock:
            entries.append(
                {"at": now, "key": key, "name": clean(dedupe) if dedupe else None, "window": window, "asked": dedupe_sev,
                 "sev": message["sev"], "rang": bool(loud and backend in RINGS_THROUGH_MUTE), "backend": backend, "source": clean(source) if source else None, **caller_fields()}
            )
            try:
                write_log(entries)
            except OSError as error:
                print(f"page: sent but not recorded: {type(error).__name__}", file=sys.stderr)
    note = ""
    if capped:
        note = ", capped, did not ring"
    elif message["sev"] == "wake" and not loud:
        note = ", quiet"
    elif loud and backend not in RINGS_THROUGH_MUTE:
        note = ", may not have rung"
    print(f"page: sent sev={message['sev']} via {backend}{note}")
    return finish(0, "capped" if capped else "sent", effective=message["sev"], backend=backend,
                  rang=bool(loud and backend in RINGS_THROUGH_MUTE), key=key,
                  text=message["text"], url=message["url"], reason=policy_reason)


def run_status():
    config, problem = load_config()
    if problem:
        print(f"config: {problem}")
    set_up = [name for name in BACKENDS if secret(config, name)]
    for name in BACKENDS:
        print(f"{name}: {'set up' if name in set_up else 'no secret file'}")
    for entry in read_log()[-10:]:
        when = time.strftime("%m-%dT%H:%M:%SZ", time.gmtime(entry["at"]))
        source = f" source={entry['source']}" if entry.get("source") else ""
        print(f"{when} {entry['sev']} via {entry['backend']} key={entry.get('name') or entry['key']}{source}")
    routed = {name for route in config["routes"].values() for name in route}
    return 0 if routed.intersection(set_up) else 1


def main(argv):
    if argv[:1] in (["history"], ["callers"]):
        parser = argparse.ArgumentParser(prog="page " + argv[0])
        parser.add_argument("--json", action="store_true")
        if argv[0] == "history":
            parser.add_argument("--source")
            parser.add_argument("--limit", type=int, default=100)
        else:
            parser.add_argument("--scan", type=Path, help="candidate call sites under this root; no code contents")
        args = parser.parse_args(argv[1:])
        rows = (support.history(state_dir(), args.source, max(1, min(args.limit, 10000))) if argv[0] == "history"
                else support.scan(args.scan) if args.scan else support.callers(state_dir()))
        if args.json:
            print(json.dumps(rows, indent=2))
        else:
            for row in rows:
                print(json.dumps(row, sort_keys=True))
        return 0
    if argv[:1] == ["status"]:
        argparse.ArgumentParser(prog="page status").parse_args(argv[1:])
        return run_status()
    if argv[:1] == ["test"]:
        parser = argparse.ArgumentParser(prog="page test")
        parser.add_argument("--sev", choices=["info", "wake"], default="info")
        parser.add_argument("--loud", action="store_true", help="really ring: a wake test is quiet without this")
        args = parser.parse_args(argv[1:])
        return run_page(
            args.sev, f"page test from {short_hostname()}", "Page test", None, None, 0, "test",
            loud=args.loud,
        )
    parser = argparse.ArgumentParser(prog="page", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=__version__)
    parser.add_argument("--sev", choices=["info", "wake"], default="info")
    parser.add_argument("--title")
    parser.add_argument("--url", help="opened when the notification is tapped, such as a ticket or dashboard")
    parser.add_argument("--dedupe", help="repeats of this key inside the window are suppressed")
    parser.add_argument("--window", type=int, help="seconds; defaults to the configured window for the severity")
    parser.add_argument("--source", help="who is paging, shown in the default title")
    parser.add_argument("--incident", help="stable incident identity; enables managed escalation policy")
    parser.add_argument("--condition", choices=["firing", "resolved", "unknown"], default="firing")
    parser.add_argument("--observed-at", help="RFC3339 observation timestamp; required for incidents")
    parser.add_argument("--human-action", help="concrete action only the human can take; required for incident wakes")
    parser.add_argument("--handling", choices=["unhandled", "automatic", "human"], default="unhandled")
    parser.add_argument("--owner", help="responder name; attribution, not proof of acknowledgement")
    parser.add_argument("--wake-after", type=int, default=600, help="continuous firing seconds before wake (0 for verified urgent harm)")
    parser.add_argument("--resolve-after", type=int, default=3600, help="continuous clear seconds to close/rearm")
    parser.add_argument("--max-age", type=int, default=300, help="maximum observation age in seconds")
    parser.add_argument("message")
    args = parser.parse_args(argv)
    incident = None
    if args.window is not None and args.window < 0:
        parser.error("--window must be nonnegative")
    if args.incident:
        if not args.source or not args.observed_at or min(args.wake_after, args.resolve_after) < 0 or args.max_age <= 0:
            parser.error("incidents require --source, --observed-at and valid nonnegative timing")
        try:
            observed = support.timestamp(args.observed_at)
        except ValueError as error:
            parser.error(str(error))
        incident = dict(name=args.incident, condition=args.condition, observed_at=observed,
                        human_action=args.human_action, handling=args.handling, owner=args.owner,
                        wake_after=args.wake_after, resolve_after=args.resolve_after, max_age=args.max_age)
    if args.sev == "wake":
        problem = wake_problem(args.message, args.dedupe)
        if problem:
            print(f"page: refusing wake: {problem}", file=sys.stderr)
            support.audit(state_dir(), dict(host=short_hostname(), source=clean(args.source or "unattributed"),
                          asked=args.sev, outcome="refused", reason=problem, **caller_fields()))
            return 2
    return run_page(args.sev, args.message, args.title, args.url, args.dedupe, args.window, args.source, incident=incident)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
